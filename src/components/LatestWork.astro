---
import { Image } from "astro:assets";

const {
	name,
	images,
	description,
	technology,
	playStoreLink,
	appStoreLink,
	platform,
	year,
	role,
	stats,
} = Astro.props;

const shouldUseCarousel = images.length > 3;

function isVideo(src: string): boolean {
	return src.toLowerCase().endsWith(".webm");
}
---

<div class="projects" data-animate="fade-up">
	<div class="desktop-images">
			{
				shouldUseCarousel ? (
					<div class="carousel" data-carousel data-autoplay="true">
						<div class="carousel-stage">
							{images.map((src: string, i: number) => (
								<div class="carousel-slide" data-slide={i}>
									{isVideo(src) ? (
										<video
											class="carousel-slide-img"
											autoplay
											loop
											muted
											playsinline
										>
											<source
												src={src}
												type="video/webm"
											/>
										</video>
									) : (
										<Image
											src={src}
											alt={`${name} screenshot ${i + 1}`}
											class="carousel-slide-img"
											width={1200}
											height={800}
										/>
									)}
									<div
										class="carousel-slide-overlay"
										data-slide-overlay
									/>
								</div>
							))}
						</div>
						<div class="carousel-dots" data-carousel-dots>
							{images.map((_: string, i: number) => (
								<button
									class={`carousel-dot${i === 0 ? " active" : ""}`}
									data-carousel-dot={i}
									aria-label={`Go to slide ${i + 1}`}
								/>
							))}
						</div>
					</div>
				) : (
					<div class="multi-image-wrapper">
						{images.map((src: string, i: number) =>
							isVideo(src) ? (
								<video
									class="multi-image"
									autoplay
									loop
									muted
									playsinline
								>
									<source src={src} type="video/webm" />
								</video>
							) : (
								<Image
									src={src}
									alt={`${name} screenshot ${i + 1}`}
									class="multi-image"
									width={1200}
									height={800}
								/>
							),
						)}
					</div>
				)
			}
		</div>

		<div class="mobile-images">
			{
				images.length > 1 ? (
					<div class="carousel" data-carousel data-autoplay="true">
						<div class="carousel-stage">
							{images.map((src: string, i: number) => (
								<div class="carousel-slide" data-slide={i}>
									{isVideo(src) ? (
										<video
											class="carousel-slide-img"
											autoplay
											loop
											muted
											playsinline
										>
											<source
												src={src}
												type="video/webm"
											/>
										</video>
									) : (
										<Image
											src={src}
											alt={`${name} screenshot ${i + 1}`}
											class="carousel-slide-img"
											width={1200}
											height={800}
										/>
									)}
									<div
										class="carousel-slide-overlay"
										data-slide-overlay
									/>
								</div>
							))}
						</div>
						<div class="carousel-dots" data-carousel-dots>
							{images.map((_: string, i: number) => (
								<button
									class={`carousel-dot${i === 0 ? " active" : ""}`}
									data-carousel-dot={i}
									aria-label={`Go to slide ${i + 1}`}
								/>
							))}
						</div>
					</div>
				) : (
					<div class="single-image-wrapper">
						{isVideo(images[0]) ? (
							<video
								class="single-image"
								autoplay
								loop
								muted
								playsinline
							>
								<source src={images[0]} type="video/webm" />
							</video>
						) : (
							<Image
								src={images[0]}
								alt={`${name} screenshot 1`}
								class="single-image"
								width={1200}
								height={800}
							/>
						)}
					</div>
				)
			}
		</div>

	<div class="project-info">
		<h2>{name}</h2>
		{
			(platform || role || year) && (
				<div class="project-meta">
					{platform && <span class="meta-tag">{platform}</span>}
					{role && <span class="meta-tag">{role}</span>}
					{year && (
						<span class="meta-tag meta-tag--year">{year}</span>
					)}
				</div>
			)
		}
		<p class="description">{description}</p>

		<div class="project-details">
			{
				stats && stats.length > 0 && (
					<div class="detail-group">
						<span class="detail-label">Highlights</span>
						<div class="detail-value">
							{stats.map((stat: string) => (
								<span class="stat-pill">{stat}</span>
							))}
						</div>
					</div>
				)
			}
			<div class="detail-group">
				<span class="detail-label">Stack</span>
				<div class="detail-value">
					{
						technology.map((tech: string, i: number) => (
							<span class="tech-pill">{tech}</span>
						))
					}
				</div>
			</div>
		</div>

		{
			(playStoreLink || appStoreLink) && (
				<div class="store-badges">
					{playStoreLink && (
						<a
							href={playStoreLink}
							target="_blank"
							class="store-btn"
						>
							<svg
								width="20"
								height="20"
								viewBox="0 0 24 24"
								xmlns="http://www.w3.org/2000/svg"
								fill-rule="evenodd"
								clip-rule="evenodd"
							>
								<path d="M1.571 23.664l10.531-10.501 3.712 3.701-12.519 6.941c-.476.264-1.059.26-1.532-.011l-.192-.13zm9.469-11.56l-10.04 10.011v-20.022l10.04 10.011zm6.274-4.137l4.905 2.719c.482.268.781.77.781 1.314s-.299 1.046-.781 1.314l-5.039 2.793-4.015-4.003 4.149-4.137zm-15.854-7.534c.09-.087.191-.163.303-.227.473-.271 1.056-.275 1.532-.011l12.653 7.015-3.846 3.835-10.642-10.612z" />
							</svg>
							<span class="store-btn-text">
								<span class="store-btn-sub">Get it on</span>
								Google Play
							</span>
						</a>
					)}
					{appStoreLink && (
						<a
							href={appStoreLink}
							target="_blank"
							class="store-btn"
						>
							<svg
								xmlns="http://www.w3.org/2000/svg"
								width="20"
								height="20"
								viewBox="0 0 24 24"
								class="apple-icon"
							>
								<path d="M22 17.607c-.786 2.28-3.139 6.317-5.563 6.361-1.608.031-2.125-.953-3.963-.953-1.837 0-2.412.923-3.932.983-2.572.099-6.542-5.827-6.542-10.995 0-4.747 3.308-7.1 6.198-7.143 1.55-.028 3.014 1.045 3.959 1.045.949 0 2.727-1.29 4.596-1.101.782.033 2.979.315 4.389 2.377-3.741 2.442-3.158 7.549.858 9.426zm-5.222-17.607c-2.826.114-5.132 3.079-4.81 5.531 2.612.203 5.118-2.725 4.81-5.531z" />
							</svg>
							<span class="store-btn-text">
								<span class="store-btn-sub">
									Download on the
								</span>
								App Store
							</span>
						</a>
					)}
				</div>
			)
		}
	</div>
</div>

<script>
	function initCarousels() {
		document.querySelectorAll("[data-carousel]").forEach((carousel) => {
			const slides = carousel.querySelectorAll(
				"[data-slide]",
			) as NodeListOf<HTMLElement>;
			const overlays = carousel.querySelectorAll(
				"[data-slide-overlay]",
			) as NodeListOf<HTMLElement>;
			const dots = carousel.querySelectorAll(
				"[data-carousel-dot]",
			) as NodeListOf<HTMLButtonElement>;
			const total = slides.length;
			let current = 0;
			let autoplayTimer: ReturnType<typeof setTimeout> | null = null;
			let isPaused = false;

			function updateSlides(index: number) {
				current = ((index % total) + total) % total;
				slides.forEach((slide, i) => {
					const offset = i - current;
					const absOffset = Math.abs(offset);

					let translateX: number;
					let scale: number;
					let opacity: number;
					let zIndex: number;
					let overlayOpacity: number;

					if (absOffset === 0) {
						translateX = 0;
						scale = 1;
						opacity = 1;
						zIndex = total + 1;
						overlayOpacity = 0;
					} else if (absOffset === 1) {
						translateX = offset * 55;
						scale = 0.82;
						opacity = 0.7;
						zIndex = total;
						overlayOpacity = 0.5;
					} else if (absOffset === 2) {
						translateX = offset * 55;
						scale = 0.65;
						opacity = 0.4;
						zIndex = total - 1;
						overlayOpacity = 0.75;
					} else {
						translateX = offset * 55;
						scale = 0.5;
						opacity = 0;
						zIndex = 0;
						overlayOpacity = 1;
					}

					slide.style.transform = `translateX(${-50 + translateX}%) scale(${scale})`;
					slide.style.opacity = String(opacity);
					slide.style.zIndex = String(zIndex);
					if (overlays[i])
						overlays[i].style.opacity = String(overlayOpacity);
				});

				dots.forEach((dot, i) => {
					dot.classList.toggle("active", i === current);
				});
			}

			function nextSlide() {
				updateSlides(current + 1);
			}

			function startAutoplay() {
				stopAutoplay();
				autoplayTimer = setInterval(() => {
					if (!isPaused) nextSlide();
				}, 3000);
			}

			function stopAutoplay() {
				if (autoplayTimer) {
					clearInterval(autoplayTimer);
					autoplayTimer = null;
				}
			}

			dots.forEach((dot, i) => {
				dot.addEventListener("click", () => {
					updateSlides(i);
					startAutoplay();
				});
			});

			carousel.addEventListener("mouseenter", () => {
				isPaused = true;
			});
			carousel.addEventListener("mouseleave", () => {
				isPaused = false;
			});

			let touchStartX = 0;
			carousel.addEventListener(
				"touchstart",
				(e: Event) => {
					touchStartX = (e as TouchEvent).touches[0].clientX;
					isPaused = true;
				},
				{ passive: true },
			);
			carousel.addEventListener(
				"touchend",
				(e: Event) => {
					const dx =
						(e as TouchEvent).changedTouches[0].clientX -
						touchStartX;
					if (Math.abs(dx) > 40) {
						updateSlides(dx < 0 ? current + 1 : current - 1);
					}
					isPaused = false;
				},
				{ passive: true },
			);

			updateSlides(0);

			if (carousel.hasAttribute("data-autoplay")) {
				startAutoplay();
			}
		});
	}

	initCarousels();
	document.addEventListener("astro:after-swap", initCarousels);
</script>

<style>
	.projects {
		padding-top: 5%;
		padding-bottom: 5%;
	}

	.projects h2 {
		padding-top: 5%;
		font-size: clamp(2.5rem, 4.5vw, 8rem);
		margin-bottom: 0px;
		overflow-wrap: break-word;
		font-weight: bold;
		letter-spacing: -0.02em;
		line-height: 1;
	}

	.project-title-link {
		text-decoration: none;
		color: inherit;
	}

	.project-meta {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		justify-content: center;
		margin-top: 1rem;
		margin-bottom: 0;
	}

	.meta-tag {
		display: inline-flex;
		align-items: center;
		padding: 0.3rem 0.75rem;
		font-size: 0.7rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: rgba(255, 255, 255, 0.5);
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.08);
		border-radius: 100px;
		backdrop-filter: blur(8px);
		transition: all 0.3s ease;
	}

	.meta-tag:hover {
		background: rgba(255, 255, 255, 0.08);
		color: rgba(255, 255, 255, 0.7);
		border-color: rgba(255, 255, 255, 0.15);
	}

	.meta-tag--year {
		font-variant-numeric: tabular-nums;
	}

	.description {
		font-size: clamp(1rem, 1.8vw, 1.25rem);
		line-height: 1.6;
		color: rgba(255, 255, 255, 0.55);
		max-width: 560px;
		margin: 1.25rem auto 0;
		font-weight: normal;
	}

	.project-details {
		margin-top: 2.5rem;
		display: flex;
		flex-direction: column;
		gap: 1.75rem;
	}

	.detail-group {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.75rem;
	}

	.detail-label {
		font-size: 0.65rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: rgba(255, 255, 255, 0.3);
	}

	.detail-value {
		display: flex;
		flex-wrap: wrap;
		gap: 0.4rem;
		justify-content: center;
	}

	.tech-pill,
	.stat-pill {
		display: inline-flex;
		align-items: center;
		padding: 0.35rem 0.7rem;
		font-size: 0.75rem;
		font-weight: 400;
		color: rgba(255, 255, 255, 0.65);
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 6px;
		transition: all 0.25s ease;
	}

	.tech-pill:hover,
	.stat-pill:hover {
		background: rgba(255, 255, 255, 0.06);
		color: rgba(255, 255, 255, 0.85);
		border-color: rgba(255, 255, 255, 0.12);
	}

	.stat-pill {
		color: rgba(255, 255, 255, 0.5);
		background: rgba(255, 255, 255, 0.02);
	}

	.image-link {
		display: block;
		text-decoration: none;
		color: inherit;
		width: 100vw;
		position: relative;
		left: 50%;
		right: 50%;
		margin-left: -50vw;
		margin-right: -50vw;
	}

	.image-link:hover .carousel-stage {
		filter: brightness(0.95);
		transition: filter 0.3s ease-in-out;
	}

	.carousel {
		position: relative;
		width: 100%;
		padding: 3rem 0 4rem;
		display: flex;
		flex-direction: column;
		align-items: center;
	}

	.carousel-stage {
		position: relative;
		width: 100%;
		height: clamp(300px, 50vw, 70vh);
		perspective: 1200px;
		overflow: hidden;
	}

	.carousel-slide {
		position: absolute;
		top: 0;
		left: 50%;
		width: 50%;
		height: 100%;
		transition:
			transform 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94),
			opacity 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
		will-change: transform, opacity;
	}

	.carousel-slide-overlay {
		position: absolute;
		inset: 0;
		background: #000;
		border-radius: 22px;
		transition: opacity 0.6s cubic-bezier(0.25, 0.46, 0.45, 0.94);
		pointer-events: none;
	}

	.carousel-slide-img {
		width: 100%;
		height: 100%;
		object-fit: contain;
		border-radius: 22px;
		display: block;
		image-rendering: -webkit-optimize-contrast;
		image-rendering: high-quality;
	}

	.carousel-dots {
		position: absolute;
		bottom: 0;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		gap: 0.5rem;
		z-index: 10;
	}

	.carousel-dot {
		width: 12px;
		height: 12px;
		border-radius: 50%;
		border: 2px solid rgba(255, 255, 255, 0.6);
		background: transparent;
		cursor: pointer;
		padding: 0;
		transition:
			background 0.3s,
			border-color 0.3s,
			transform 0.3s;
	}

	.carousel-dot.active {
		background: white;
		border-color: white;
		transform: scale(1.3);
	}

	.carousel-dot:hover {
		border-color: white;
	}

	.single-image-wrapper {
		width: 100%;
		display: flex;
		justify-content: center;
		padding: 3rem 0 4rem;
	}

	.single-image {
		width: 50%;
		height: clamp(300px, 50vw, 70vh);
		object-fit: contain;
		border-radius: 22px;
		image-rendering: -webkit-optimize-contrast;
		image-rendering: high-quality;
	}

	.multi-image-wrapper {
		width: 100%;
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 2rem;
		padding: 3rem 0 4rem;
	}

	.multi-image {
		flex: 1 1 0;
		max-width: 45%;
		min-width: 0;
		height: clamp(300px, 50vw, 70vh);
		object-fit: contain;
		border-radius: 22px;
		image-rendering: -webkit-optimize-contrast;
		image-rendering: high-quality;
	}

	.project-info {
		max-width: 800px;
		margin: 0 auto;
		padding: 0 5%;
		display: flex;
		flex-direction: column;
		justify-content: center;
		text-align: center;
	}

	.store-badges {
		display: flex;
		gap: 0.75rem;
		margin-top: 2.5rem;
		flex-wrap: wrap;
		justify-content: center;
	}

	.store-btn {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		padding: 0.65rem 1.1rem;
		font-size: 0.85rem;
		font-weight: 500;
		text-decoration: none;
		color: rgba(255, 255, 255, 0.85);
		background: rgba(255, 255, 255, 0.04);
		border: 1px solid rgba(255, 255, 255, 0.1);
		border-radius: 12px;
		transition:
			background 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94),
			border-color 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94),
			color 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94),
			transform 0.3s cubic-bezier(0.25, 0.46, 0.45, 0.94);
		backdrop-filter: blur(12px);
		position: relative;
		overflow: visible;
	}

	.store-btn:hover {
		background: rgba(255, 255, 255, 0.08);
		border-color: rgba(255, 255, 255, 0.2);
		color: #fff;
		transform: translateY(-1px);
	}

	.store-btn svg {
		fill: currentColor;
		opacity: 0.8;
		flex-shrink: 0;
		width: 20px;
		height: 20px;
		overflow: visible;
	}

	.store-btn-text {
		display: flex;
		flex-direction: column;
		align-items: flex-start;
		line-height: 1.2;
	}

	.store-btn-sub {
		font-size: 0.55rem;
		font-weight: 400;
		opacity: 0.5;
		letter-spacing: 0.02em;
	}

	.desktop-images {
		display: block;
	}

	.mobile-images {
		display: none;
	}

	@media screen and (max-width: 768px) {
		.projects {
			padding-top: 8% !important;
			padding-bottom: 8% !important;
		}

		.projects h2 {
			font-size: clamp(2rem, 10vw, 5rem);
			margin: 0;
			padding: 0;
			word-break: break-word;
			overflow-wrap: break-word;
		}

		.description {
			font-size: clamp(0.875rem, 4vw, 1rem);
			text-align: left !important;
			word-break: break-word;
			overflow-wrap: break-word;
			margin-left: 0;
			margin-right: 0;
		}

		.project-info {
			text-align: left;
		}

		.project-meta {
			justify-content: flex-start;
		}

		.detail-group {
			align-items: flex-start;
		}

		.detail-value {
			justify-content: flex-start;
		}

		.carousel-stage {
			height: clamp(300px, 85vw, 600px);
		}

		.carousel-slide {
			width: 98%;
		}

		.carousel {
			padding: 1.5rem 0;
		}

		.single-image-wrapper {
			padding: 1.5rem 0;
		}

		.single-image {
			width: 98%;
			height: clamp(300px, 85vw, 600px);
		}

		.multi-image-wrapper {
			flex-direction: column;
			align-items: center;
			gap: 1.5rem;
			padding: 1.5rem 0;
		}

		.multi-image {
			width: 98%;
			max-width: 98%;
			min-width: unset;
			height: clamp(300px, 85vw, 600px);
		}

		.store-badges {
			margin-bottom: 1.5rem;
		}

		.desktop-images {
			display: none;
		}

		.mobile-images {
			display: block;
		}

		.carousel-dot {
			width: 10px;
			height: 10px;
		}
	}
</style>
