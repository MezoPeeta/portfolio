---
import NavBar from "../components/NavBar.astro";
import Trailer from "../components/trailer.astro";

interface Props {
  title: string;
}

const { title } = Astro.props;
Astro.response.headers.set("Cache-Control", "public,max-age=604800,immutable");
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="color-scheme" content="dark" />

    <!-- Primary Meta Tags -->
    <meta name="title" content="Mazen Omar" />
    <meta
      name="description"
      content="Hi, I'm Mazen Omar, a Mobile Engineer who obsesses over quality and detail. I craft polished mobile experiences, turning complex problems into elegant, purposeful products."
    />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://mazen.vercel.app/" />
    <meta property="og:title" content="Mazen Omar" />
    <meta
      property="og:description"
      content="Hi, I'm Mazen Omar, a Mobile Engineer who obsesses over quality and detail. I craft polished mobile experiences, turning complex problems into elegant, purposeful products."
    />
    <meta
      property="og:image"
      content="https://mazen.vercel.app/img/meta.webp"
    />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="627" />

    <!-- X (Twitter) -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://mazen.vercel.app/" />
    <meta name="twitter:title" content="Mazen Omar" />
    <meta
      name="twitter:description"
      content="Hi, I'm Mazen Omar, a Mobile Engineer who obsesses over quality and detail. I craft polished mobile experiences, turning complex problems into elegant, purposeful products."
    />
    <meta
      name="twitter:image"
      content="https://mazen.vercel.app/img/meta.webp"
    />

    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href="/favicon.svg" />
    <link
      rel="preload"
      href="/font/ClashGrotesk-Regular.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="preload"
      href="/font/ClashGrotesk-Medium.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <link
      rel="stylesheet"
      href="https://site-assets.fontawesome.com/releases/v6.5.1/css/all.css"
    />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
  </head>
  <body id="bg" style="scroll-behavior: smooth;">
    <Trailer />
    <NavBar />
    <slot />
    <footer>
      <div class="footer">
        <h1 style="font-size: 1rem;">
          © Mazen <span id="currentYear"></span>
        </h1>
        <a
          href="https://www.x.com/_mazenomar"
          target="_blank"
          style="color:white">X (Twitter)</a
        >
        <a
          href="https://www.linkedin.com/in/mazenomar1/"
          style="color:white"
          target="_blank">Linkedin</a
        >
        <a
          href="https://github.com/mezopeeta/"
          style="color:white"
          target="_blank">Github</a
        >
        <a href="#bg" aria-label="scrollIcon">
          <div style="display:flex;align-items:center;">
            <div class="scrollbg">
              <i class="fa-solid fa-arrow-up" id="scrollIcon"></i>
            </div>
          </div>
        </a>
      </div>

      <div style="display:block">
        <p>Made with ❤ by Mazen</p>
      </div>
    </footer>
    <script src="../ts/animateTrailer.ts"></script>
  </body>
</html>
<style is:global>
  @font-face {
    font-family: ClashGrotesk;
    src: url("/font/ClashGrotesk-Regular.woff2") format("woff2");
    font-weight: normal;
    font-display: block;
  }
  @font-face {
    font-family: ClashGrotesk;
    src: url("/font/ClashGrotesk-Medium.woff2") format("woff2");
    font-weight: bold;
    font-display: block;
  }

  [data-animate] {
    transition:
      opacity 0.8s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.8s cubic-bezier(0.22, 1, 0.36, 1);
  }
  [data-animate="fade-up"] {
    opacity: 0;
    transform: translateY(60px);
  }
  [data-animate="fade-left"] {
    opacity: 0;
    transform: translateX(-60px);
  }
  [data-animate="fade-right"] {
    opacity: 0;
    transform: translateX(60px);
  }
  [data-animate="fade"] {
    opacity: 0;
  }
  [data-animate].visible {
    opacity: 1;
    transform: translate(0, 0);
  }

  html {
    font-family: ClashGrotesk;
    background-size: 224px;
  }
  html,
  body {
    background-color: #000;
    color: #fff;
    margin: 0;
    padding: 0;
    overflow-x: hidden;
  }
  footer {
    background: #111;
    border-top: 1px solid #333;
    color: white;
    text-align: center;
    height: 300px;
  }
  .footer {
    height: 250px;
    align-items: center;
    display: flex;
    justify-content: space-around;
    text-transform: uppercase;
  }
  #scrollIcon {
    color: white;
    margin-top: 12px;
  }

  .scrollbg {
    border: 2px solid white;
    width: 40px;
    height: 40px;
    border-radius: 50%;
  }

  a {
    text-decoration: none;
    color: #fff;
  }

  svg {
    fill: white;
  }

  body {
    padding-top: 5rem;
  }

  @media screen and (max-width: 768px) {
    .footer {
      flex-direction: column;
    }
  }
</style>

<script>
  document.getElementById("currentYear")!.innerHTML =
    `${new Date().getFullYear()}`;

  const observer = new IntersectionObserver(
    (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add("visible");
          observer.unobserve(entry.target);
        }
      });
    },
    { threshold: 0.12 },
  );

  document.querySelectorAll("[data-animate]").forEach((el) => {
    observer.observe(el);
  });
</script>
